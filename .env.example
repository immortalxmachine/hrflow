# HRFlow environment variables. Copy to ".env" and adjust.
# ".env" is git-ignored; never commit real secrets.

# --- Backend database (Spring Boot) ---
HRFLOW_DB_URL=jdbc:postgresql://localhost:5432/hrflow
HRFLOW_DB_USER=hrflow
HRFLOW_DB_PASSWORD=hrflow

# --- JWT signing (HS256; secret must be >= 32 bytes) ---
HRFLOW_JWT_SECRET=dev-only-insecure-secret-change-me-32bytes-min!!
HRFLOW_JWT_EXPIRY_MINUTES=120

# --- Outbound payroll webhook (the mock FastAPI service) ---
HRFLOW_PAYROLL_URL=http://localhost:8001/webhooks/leave-approved
HRFLOW_WEBHOOK_SECRET=dev-webhook-secret
HRFLOW_WEBHOOK_MAX_ATTEMPTS=3

# --- Mock payroll service (FastAPI) ---
# Shared HMAC secret MUST match HRFLOW_WEBHOOK_SECRET above.
PAYROLL_WEBHOOK_SECRET=dev-webhook-secret
# Fraction of requests the mock randomly fails, to exercise retry logic (0.0-1.0).
PAYROLL_FAIL_RATE=0.0

# --- Seed synthetic data on backend startup (dev only) ---
HRFLOW_SEED=false

# --- Ports ---
HRFLOW_PORT=8080
# payroll-mock runs on 8001 (see payroll-mock/README)
